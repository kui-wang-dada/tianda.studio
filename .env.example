# 仓库唯一的环境变量样板。复制为 `.env`（已 gitignore）后 scp 上传到 VPS。
# 本地开发：所有变量都在代码里有默认值，无需 .env 也能跑。需要覆盖时在
# frontend/.env.local 或 admin/.env.local 手动创建。

# ─────────────────────────────────────────────────
# 1. VPS docker-compose 运行时变量（api 容器会读取）
# ─────────────────────────────────────────────────

# Postgres
DB_PASSWORD=change-me-strong-password

# API
ENV=prod
ADMIN_TOKEN=generate-a-long-random-token
IP_SALT=another-long-random-string

# Comma-separated browser origins allowed by FastAPI CORS. Each subdomain
# must be listed because allow_credentials=True forbids wildcards.
CORS_ORIGINS=https://tianda.studio,https://admin.tianda.studio

# Shared cookie domain — leading dot lets api/web/admin subdomains see the
# same cookie (refresh-token flow lands here in V2 M1).
COOKIE_DOMAIN=.tianda.studio
COOKIE_SECURE=true

# ─────────────────────────────────────────────────
# 2. 本地开发覆盖（仅在你想偏离默认值时使用）
#
#   frontend/.env.local 可写：
#     NEXT_PUBLIC_API_BASE=http://localhost:8000
#     NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
#   admin/.env.local 可写：
#     VITE_API_BASE=http://localhost:8000
#
#   backend/.env 可写（仅 `make dev-api` 原生跑时；docker compose 不读它）：
#     ENV=dev
#     DATABASE_URL=postgresql+asyncpg://tianda:tianda@localhost:5432/tianda
#     ADMIN_TOKEN=dev-admin-token
#     IP_SALT=dev-salt
#     CORS_ORIGINS=http://localhost:3000,http://localhost:3002
#     COOKIE_DOMAIN=
#     COOKIE_SECURE=false
#
#   生产构建时前端两组变量在 scripts/deploy-{frontend,admin}.sh 里有默认值；
#   后端运行时从本文件第 1 段读取（compose 直接 environment: 透传）。
# ─────────────────────────────────────────────────
